SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Replace goanywhere_db with your local MySQL schema name.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/goanywhere_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me

# Generate a private Base64 key with: openssl rand -base64 32
JWT_SECRET=replace_with_a_private_base64_secret
JWT_EXPIRATION_MS=86400000
